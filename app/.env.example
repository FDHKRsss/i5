# Host port the app is published on (the Cloudflare Quick Tunnel origin).
# Default 81 as requested; change it if 81 is already taken on the host.
APP_PORT=81

# PostgreSQL credentials (used by both the db service and the app).
POSTGRES_USER=civil42
POSTGRES_PASSWORD=civil42
POSTGRES_DB=civil42

# Reverse-geocode provider. Only "mock" is implemented for the seed.
GEO_PROVIDER=mock

# Maximum upload size in bytes (default 15 MB).
MAX_UPLOAD_BYTES=15728640
